{
  "$comment": "DataProvider 契約（design D4）：payload 頂層形狀，與 embed.py build_payload 同構。前端與 HTML 匯出共用。",
  "type": "object",
  "required": ["meta", "encounters", "meds_by_enc", "medications", "labs",
    "reports", "immunizations", "nhi_body", "knowledge", "activity",
    "measures", "measure_bands", "sleep_daily", "body_refs",
    "workouts", "cpap"],
  "properties": {
    "meta": { "type": "object",
      "required": ["generated_at", "date_min", "date_max", "profile", "counts", "sources", "drug_cache"] },
    "encounters": { "type": "array" },
    "meds_by_enc": { "type": "object" },
    "medications": { "type": "array" },
    "labs": { "type": "array" },
    "reports": { "type": "array" },
    "immunizations": { "type": "array" },
    "nhi_body": { "type": "array" },
    "knowledge": { "type": "object" },
    "activity": { "type": "object" },
    "measures": { "type": "object" },
    "measure_bands": { "type": "object" },
    "sleep_daily": { "type": "array" },
    "body_refs": { "type": "array" },
    "workouts": { "type": "array" },
    "cpap": { "type": "object",
      "required": ["daily", "event_daily", "events", "events_total",
        "events_nights", "events_nights_total", "events_truncated",
        "oximetry"] }
  }
}
